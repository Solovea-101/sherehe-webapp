{
  "name": "sherehe-webapp",
  "version": "0.1.0",
  "private": true,
  "description": "Sherehe: events and staffing roles for organisers in Kenya. Website and API in one Next.js app.",
  "engines": {
    "node": ">=20.9"
  },
  "workspaces": [
    "tools/generate-types"
  ],
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "typecheck": "tsc --noEmit",
    "types": "npm run generate --workspace tools/generate-types",
    "test": "next build && jest --runInBand",
    "verify": "next build && NODE_ENV=production tsx scripts/verifyContract.ts",
    "db:migrate": "tsx lib/db/migrate.ts"
  },
  "dependencies": {
    "@next/env": "^16.4.2",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "ajv": "^8.20.0",
    "jest": "^30.5.2",
    "openapi-types": "^12.1.3",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
