# Copy to .env for local runs. Real values live in Render's settings, never in git.
PORT=3000
# PostgreSQL. Leave empty to use the in-memory store (tests, clean clones).
DATABASE_URL=
# Our upstream: Ujuzi
UJUZI_API_URL=https://ujuzi-TODO.onrender.com
UJUZI_API_KEY=
# SHA-256 hashes of the X-API-Keys we issue to Kazi Connect, comma-separated
PARTNER_KEYS=
SESSION_SECRET=change-me
# Optional tuning, in milliseconds. The defaults are right for production.
# UJUZI_TIMEOUT_MS=          # overrides both Ujuzi timeouts (10 s while a person waits, 60 s in the background)
# BOOKING_POLL_MS=300000     # how often the poller asks Ujuzi about pending crew trainings
