# Copy to .env for local runs. Real values live in Render's settings, never in git.
PORT=3000
# PostgreSQL. Leave empty to use the in-memory store (tests, clean clones).
DATABASE_URL=
# Our upstream: Ujuzi
UJUZI_API_URL=https://ujuzi-TODO.onrender.com
UJUZI_API_KEY=
# SHA-256 hashes of the X-API-Keys we issue to Kazi Connect, comma-separated
PARTNER_KEYS=
SESSION_SECRET=change-me
# Optional tuning, in milliseconds. The defaults are right for production.
# UJUZI_TIMEOUT_MS=          # overrides both Ujuzi timeouts (10 s while a person waits, 60 s in the background)
# BOOKING_POLL_MS=300000     # how often the poller asks Ujuzi about pending crew trainings
# On a deployment, refuse every partner call until a key is configured (otherwise empty PARTNER_KEYS leaves them open).
# REQUIRE_PARTNER_KEY=true
# Rate limit (Week 9). Requests per minute for each partner key, and for everything else per address; sign-ups and logins have their own smaller allowance.
# RATE_LIMIT_MAX=100          # 0 switches the limit off (only the tests do)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_LOGIN_MAX=10
# On Render, tell callers apart by the address the proxy saw, not by the proxy's own.
# TRUST_PROXY=true
# Leave a new database empty instead of loading the sample events.
# SEED_SAMPLE_DATA=false
# Only for `npm run ring:check`: our own deployment, a raw partner key it accepts, and (optional) a real account on it.
# SHEREHE_URL=https://sherehe-TODO.onrender.com
# SHEREHE_PARTNER_KEY=
# SHEREHE_CHECK_EMAIL=
# SHEREHE_CHECK_PASSWORD=
